# ===== Configuration du bot vidéo WhatsApp (Baileys + yt-dlp) =====

# Ton numéro WhatsApp en format international, SANS le + ni espaces.
# C'est le numéro lié au bot via le code d'appairage. (ex: 22901234567)
MY_PHONE_NUMBER=22901234567

# Clé qui protège les pages /pair, /backup et /restore (?key=CETTE_CLE)
PAIR_SECRET=ma_cle_secrete

# Optionnel : cookies YouTube pour débloquer les téléchargements bloqués
# par l'anti-bot de YouTube sur les serveurs.
# = contenu du fichier cookies.txt (export navigateur, voir README §6),
#   soit en base64 (recommandé) :  base64 -w0 cookies.txt
# YOUTUBE_COOKIES=

# Optionnel : dossier de la session WhatsApp.
# Si vous attachez un disque Render, mettez le chemin du disque,
# ex. AUTH_DIR=/auth → et attachez le disque sur /auth.
# AUTH_DIR=/auth

# Optionnel : restreindre le bot à certains numéros (virgules)
# ALLOWED_FROM=22901234567,22998765432

# Optionnel : API de secours (utilisée si yt-dlp local échoue, ex. anti-bot
# YouTube). Mettre vide pour la désactiver.
# DOWNLOAD_API=https://apischristus.vercel.app/api/auto
